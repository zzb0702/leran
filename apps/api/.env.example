# 复制为 apps/api/.env 后按需修改；本文件不含任何密钥
FFMPEG_PATH=C:\path\to\ffmpeg.exe

# 本地 faster-whisper（可选）
LOCAL_WHISPER_MODEL=distil
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_CPU_THREADS=8
LOCAL_WHISPER_VAD=false
LOCAL_WHISPER_DOWNLOAD_ROOT=E:\leran-models\whisper

# 大文件 / 流水线
TRANSLATE_BATCH_SIZE=8
TRANSLATE_DELAY_S=2
TRANSLATE_MAX_RETRIES=6
MAX_CONCURRENT_JOBS=1

# 离线 ECDICT 词典（文件不存在会自动跳过该查词层）
ECDICT_DB_PATH=E:\leran-models\ecdict\ecdict.db
